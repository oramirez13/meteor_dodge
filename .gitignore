__pycache__/
*.pyc
*.pyo
.venv/
venv/

# PyInstaller
build/
dist/
*.spec

# ============================================================
# Assets: keep ONLY what the game actually uses (organized under
# assets/sounds/sfx/, assets/sounds/music/, assets/images/).
# Ignore everything else (raw downloads, zip extractions, etc.)
# ============================================================

# Ignore all raw source files in the root of assets/sounds/
assets/sounds/*.wav
assets/sounds/*.ogg
assets/sounds/*.mp3
assets/sounds/*.zip
assets/sounds/INFO.txt

# Ignore extracted sound packs
assets/sounds/SpaceShipShooting/

# Ignore all zip files in assets/images/
assets/images/*.zip

# Ignore extracted/extra image directories (from zip extractions)
assets/images/SpaceGame/
assets/images/large/
assets/images/medium/
assets/images/small/
assets/images/meteors/
assets/images/rotationY*.png
